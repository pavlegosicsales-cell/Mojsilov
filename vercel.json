{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Static site — no install needed'",
  "buildCommand": "echo 'Static site — no build step'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/blog-sitemap"
    }
  ]
}
